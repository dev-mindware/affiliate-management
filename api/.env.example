# --- PROJECT SETTINGS ---
PROJECT_NAME="Mindware Affiliate System"
API_PREFIX="/api"
PORT=3333
SECRET_KEY="mudar-para-algo-seguro-em-producao"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001", "http://localhost:3002"]

# --- POSTGRES ---
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mindware_affiliates
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mindware_affiliates?schema=public"

# --- REDIS ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- CLOUDFLARE R2 (S3-Compatible) ---
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key
S3_BUCKET=mindware-affiliates
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_REGION=auto
S3_PUBLIC_URL="https://pub-xxxx.r2.dev"

# --- EMAIL (FastAPI-Mail) ---
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-password
MAIL_FROM=noreply@mindware.ao
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_STARTTLS=True
MAIL_SSL_TLS=False
USE_CREDENTIALS=True
ADMIN_NOTIFICATION_EMAILS="admin1@x.ao,admin2@x.ao"
APP_AFFILIATE_URL="http://localhost:3002"

# --- WEBHOOK ---
WEBHOOK_SECRET=your-secure-webhook-token

# --- ADMIN INITIAL ACCOUNT ---
FIRST_ADMIN_EMAIL=admin@mindware.ao
FIRST_ADMIN_PASSWORD=admin-password

# --- MINDGEST API (backend, não o frontend Vercel) ---
# Ex.: https://mindgest-api.seudominio.com  ou  http://nome-do-servico-dokploy:PORT
MINDGEST_API_URL=http://localhost:3001
MINDGEST_API_KEY=your-mindgest-api-key
