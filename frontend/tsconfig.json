{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@workspace/ui": [
        "./src/workspace/ui"
      ],
      "@workspace/ui/*": [
        "./src/workspace/ui/*"
      ],
      "@workspace/hooks": [
        "./src/workspace/hooks"
      ],
      "@workspace/hooks/*": [
        "./src/workspace/hooks/*"
      ],
      "@workspace/types": [
        "./src/workspace/types"
      ],
      "@workspace/types/*": [
        "./src/workspace/types/*"
      ],
      "@workspace/utils": [
        "./src/workspace/utils"
      ],
      "@workspace/utils/*": [
        "./src/workspace/utils/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
